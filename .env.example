# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast

# Whisper settings
WHISPER_MODEL=small
# Device to run Whisper on: 'cpu', 'cuda', or 'auto'
WHISPER_DEVICE=cpu

# Nvidia NIM API Settings for scoring
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Groq API Settings for scoring
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage directories
UPLOAD_DIR=uploads
OUTPUT_DIR=output
TEMP_DIR=temp

# Worker settings
WORKER_POLL_INTERVAL=5
